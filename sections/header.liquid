<script src="{{ 'navigation.js' | asset_url }}" defer></script>
<nova-navigation class="nova-header">
  <header class="nova-header__inner">
    <a class="nova-header__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {% if section.settings.logo != blank %}
        {% assign logo_alt = section.settings.logo.alt | default: shop.name %}
        {{ section.settings.logo | image_url: width: 480 | image_tag: widths: '120, 180, 240, 360, 480', sizes: '(max-width: 989px) 120px, 180px', alt: logo_alt, class: 'nova-header__logo', loading: 'eager' }}
      {% else %}
        {{ shop.name | escape }}
      {% endif %}
    </a>
    <nav class="nova-header__desktop" aria-label="{{ 'navigation.main' | t }}">
      {% if section.settings.menu.links != blank %}
        {% render 'navigation-links', links: section.settings.menu.links %}
      {% else %}
        <a href="{{ routes.all_products_collection_url }}">{{ 'navigation.shop_all' | t }}</a>
      {% endif %}
    </nav>
    <div class="nova-header__actions">
      <a class="nova-header__action" href="{{ routes.search_url }}" aria-label="{{ 'search.title' | t }}">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg>
      </a>
      {% if shop.customer_accounts_enabled %}
        <a class="nova-header__action nova-header__account" href="{{ routes.account_url }}" aria-label="{{ 'navigation.account' | t }}">
          <span aria-hidden="true">{{ 'icon-account.svg' | inline_asset_content }}</span>
        </a>
      {% endif %}
      <a class="nova-header__action nova-header__cart" href="{{ routes.cart_url }}" aria-label="{{ 'navigation.cart_count' | t: count: cart.item_count }}">
        <span aria-hidden="true">{{ 'icon-cart.svg' | inline_asset_content }}</span>
        <span class="nova-header__count" aria-hidden="true">{{ cart.item_count }}</span>
      </a>
    </div>
    <details class="nova-header__mobile">
      <summary>{{ 'navigation.menu' | t }}</summary>
      <nav aria-label="{{ 'navigation.main' | t }}">
        {% if section.settings.menu.links != blank %}
          {% render 'navigation-links', links: section.settings.menu.links %}
        {% else %}
          <a href="{{ routes.all_products_collection_url }}">{{ 'navigation.shop_all' | t }}</a>
        {% endif %}
      </nav>
    </details>
  </header>
</nova-navigation>

{% schema %}
{
  "name": "t:general.header",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
