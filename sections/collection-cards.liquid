{% assign selected_count = 0 %}
{% for block in section.blocks %}{% if block.settings.collection != blank %}{% assign selected_count = selected_count | plus: 1 %}{% endif %}{% endfor %}
{% if selected_count > 0 or request.design_mode %}
  <div class="nova-section">
    <div class="nova-section-heading">
      {% if section.settings.eyebrow != blank %}<p class="nova-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2>{{ section.settings.heading | escape }}</h2>
      {% if section.settings.description != blank %}<div class="nova-richtext">{{ section.settings.description }}</div>{% endif %}
    </div>
    <div class="nova-collection-grid">
      {% for block in section.blocks %}
        {% assign selected_collection = block.settings.collection %}
        {% if selected_collection != blank %}
          {% assign card_image = block.settings.image | default: selected_collection.image | default: selected_collection.products.first.featured_image %}
          <a class="nova-collection-card" href="{{ selected_collection.url }}" {{ block.shopify_attributes }}>
            {% if card_image != blank %}{{ card_image | image_url: width: 1200 | image_tag: widths: '360, 540, 750, 1000, 1200', sizes: '(min-width: 990px) 33vw, (min-width: 600px) 50vw, 100vw', loading: 'lazy', alt: '' }}{% endif %}
            <h3>{{ block.settings.title_override | default: selected_collection.title | escape }} <span aria-hidden="true">&rarr;</span></h3>
          </a>
        {% elsif request.design_mode %}<p {{ block.shopify_attributes }}>{{ 'home.configure' | t }}</p>{% endif %}
      {% endfor %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "t:general.collection_cards",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "t:defaults.collections_heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:labels.description"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "t:general.collection_card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:labels.collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "text",
          "id": "title_override",
          "label": "t:labels.title_override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.collection_cards",
      "blocks": [
        {
          "type": "collection_card"
        },
        {
          "type": "collection_card"
        },
        {
          "type": "collection_card"
        }
      ]
    }
  ]
}
{% endschema %}
