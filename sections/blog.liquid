<div class="nova-section"><h1 class="nova-page-title">{{ blog.title | escape }}</h1>{% paginate blog.articles by 12 %}<div class="nova-article-grid">{% for article in blog.articles %}<article>{% if article.image %}<a href="{{ article.url }}">{{ article.image | image_url: width: 1000 | image_tag: widths: '480, 750, 1000', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy', alt: article.image.alt }}</a>{% endif %}<h2><a href="{{ article.url }}">{{ article.title | escape }}</a></h2><p>{{ article.published_at | time_tag: format: 'date' }}</p><div class="nova-richtext">{{ article.excerpt }}</div></article>{% endfor %}</div>{% render 'pagination', paginate: paginate %}{% endpaginate %}</div>

{% schema %}
{
  "name": "t:general.blog",
  "settings": []
}
{% endschema %}
