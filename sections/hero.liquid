{% liquid
  assign loading = 'lazy'
  assign priority = 'auto'
  if section.index == 1
    assign loading = 'eager'
    assign priority = 'high'
  endif
  assign cta_url = section.settings.cta_link
  if cta_url == blank and section.settings.use_catalog
    assign cta_url = routes.all_products_collection_url
  endif
%}
<div class="nova-hero full-width nova-hero--{{ section.settings.color_style }} nova-hero--{{ section.settings.content_align }}">
  {% if section.settings.background_image != blank %}
    <div class="nova-hero__image" aria-hidden="true">{{ section.settings.background_image | image_url: width: 2400 | image_tag: widths: '480, 750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: loading, fetchpriority: priority, alt: '' }}</div>
  {% endif %}
  <div class="nova-hero__grid"><div class="nova-hero__content">
    {% if section.settings.eyebrow != blank %}<p class="nova-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <{{ section.settings.heading_level }} class="nova-hero__heading">{{ section.settings.heading | escape }}</{{ section.settings.heading_level }}>
    {% if section.settings.subtext != blank %}<div class="nova-richtext">{{ section.settings.subtext }}</div>{% endif %}
    {% if section.settings.cta_label != blank and cta_url != blank %}<a class="nova-button nova-button--primary" href="{{ cta_url | escape }}">{{ section.settings.cta_label | escape }} <span aria-hidden="true">&rarr;</span></a>{% endif %}
    {% content_for 'blocks' %}
  </div></div>
</div>

{% schema %}
{
  "name": "t:general.hero",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background_image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "t:defaults.hero_heading"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "t:labels.heading_level",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "t:labels.subtext"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:labels.cta_label",
      "default": "t:defaults.cta_label"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:labels.cta_link"
    },
    {
      "type": "checkbox",
      "id": "use_catalog",
      "label": "t:labels.use_catalog",
      "default": true
    },
    {
      "type": "select",
      "id": "color_style",
      "label": "t:labels.color_style",
      "options": [
        {
          "value": "standard",
          "label": "t:options.color_style.standard"
        },
        {
          "value": "inverse",
          "label": "t:options.color_style.inverse"
        }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "t:labels.content_align",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        },
        {
          "value": "right",
          "label": "t:options.alignment.right"
        }
      ],
      "default": "left"
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "presets": [
    {
      "name": "t:general.hero"
    }
  ]
}
{% endschema %}
