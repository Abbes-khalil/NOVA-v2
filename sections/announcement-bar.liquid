{% if section.settings.text != blank %}
  <div class="nova-announcement full-width">
    {% if section.settings.link != blank %}
      <a href="{{ section.settings.link | escape }}">{{ section.settings.text | escape }} <span aria-hidden="true">&rarr;</span></a>
    {% else %}
      <p>{{ section.settings.text | escape }}</p>
    {% endif %}
  </div>
{% endif %}

{% schema %}
{
  "name": "t:general.announcement_bar",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:labels.text",
      "default": "t:defaults.announcement"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.button_link"
    }
  ],
  "presets": [
    {
      "name": "t:general.announcement_bar"
    }
  ]
}
{% endschema %}
