{% comment %}
  NOVA's configurable content foundation. Reuses Skeleton's custom-section
  and theme blocks; JSON templates own the composition and merchant values.
{% endcomment %}
{% liquid
  assign image_loading = 'lazy'
  if section.index == 1
    assign image_loading = 'eager'
  endif
%}
<div class="custom-section full-width custom-section--{{ section.settings.color_style }}">
  {% if section.settings.background_image != blank %}
    <div class="custom-section__background" aria-hidden="true">
      {{ section.settings.background_image
        | image_url: width: 2400
        | image_tag: widths: '480, 750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: image_loading, alt: ''
      }}
    </div>
  {% endif %}
  <div class="custom-section__content">
    <div class="custom-section__body">
      {% if section.settings.eyebrow != blank %}
        <p class="custom-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <{{ section.settings.heading_level }} class="custom-section__heading">
          {{ section.settings.heading | escape }}
        </{{ section.settings.heading_level }}>
      {% endif %}
      {% if section.settings.description != blank %}
        <div class="nova-richtext custom-section__description">{{ section.settings.description }}</div>
      {% endif %}
      <div class="custom-section__blocks">{% content_for 'blocks' %}</div>
    </div>
  </div>
</div>

{% stylesheet %}
  .custom-section { position: relative; isolation: isolate; width: 100%; background: var(--color-background); color: var(--color-foreground); }
  .custom-section--inverse { background: var(--color-foreground); color: var(--color-background); }
  .custom-section__background { position: absolute; inset: 0; z-index: -1; overflow: hidden; }
  .custom-section__background img { width: 100%; height: 100%; object-fit: cover; }
  .custom-section__content { display: grid; grid-template-columns: var(--content-grid); padding-block: var(--section-spacing); }
  .custom-section__body { grid-column: 2; min-width: 0; width: min(100%, 52rem); padding: var(--space-4); background: var(--color-background); color: var(--color-foreground); }
  .custom-section--inverse .custom-section__body { background: var(--color-foreground); color: var(--color-background); }
  .custom-section__eyebrow { margin-block-end: var(--space-2); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; }
  .custom-section__heading { font-size: clamp(2.5rem, 7vw, 6rem); font-weight: 700; line-height: 1.05; letter-spacing: -0.045em; text-wrap: balance; }
  .custom-section__description { margin-block-start: var(--space-3); max-width: 40rem; }
  .custom-section__blocks { display: grid; gap: var(--space-3); margin-block-start: var(--space-4); }
  .custom-section__blocks:empty { display: none; }
  @media (max-width: 749px) { .custom-section__content { padding-block: min(var(--section-spacing), 40px); } .custom-section__body { padding: 0; } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.nova_content",
  "tag": "section",
  "class": "nova-content-section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "t:defaults.heading"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "t:labels.heading_level",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:labels.description"
    },
    {
      "type": "select",
      "id": "color_style",
      "label": "t:labels.color_style",
      "options": [
        {
          "value": "standard",
          "label": "t:options.color_style.standard"
        },
        {
          "value": "inverse",
          "label": "t:options.color_style.inverse"
        }
      ],
      "default": "standard"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background"
    }
  ],
  "presets": [
    {
      "name": "t:general.nova_content"
    }
  ]
}
{% endschema %}
