<div class="nova-section nova-page-content"><p class="nova-eyebrow">{{ shop.name | escape }}</p><h1 class="nova-page-title">{{ 'password.title' | t }}</h1>{% if shop.password_message %}<div class="nova-richtext">{{ shop.password_message }}</div>{% endif %}
{% form 'storefront_password', class: 'nova-password-form' %}{% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}<label for="Password-{{ section.id }}">{{ 'password.password' | t }}</label><input type="password" name="password" id="Password-{{ section.id }}" required autocomplete="current-password"><button class="nova-button nova-button--primary" type="submit">{{ 'password.enter' | t }}</button>{% endform %}</div>

{% schema %}
{
  "name": "t:general.password",
  "settings": []
}
{% endschema %}
